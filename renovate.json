{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>codesphere-cloud/renovate-config:go-config"],
	"ignorePaths": ["testdata/charts/**", "testdata/attestation/chart/**"],
	"packageRules": [
		{
			"matchManagers": ["gomod"],
			"postUpgradeTasks": {
				"commands": ["go mod tidy", "make generate-notice"]
			}
		},
		{
			"matchDepNames": ["CycloneDX/cyclonedx-cli"],
			"postUpgradeTasks": {
				"commands": ["scripts/pin-cyclonedx.sh"],
				"fileFilters": ["setup-cyclonedx/install.sh"]
			}
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)action\\.yml$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)"
			]
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)setup-cyclonedx/install\\.sh$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
			],
			"extractVersionTemplate": "^v(?<version>.+)$"
		}
	]
}
